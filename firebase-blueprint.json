{
  "entities": {
    "article": {
      "title": "Article",
      "description": "An article or reflection (Refleksjoner) written by the author.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "createdAt": { "type": "number", "description": "Timestamp" },
        "updatedAt": { "type": "number", "description": "Timestamp" },
        "published": { "type": "boolean" },
        "authorId": { "type": "string" }
      },
      "required": ["title", "content", "createdAt", "updatedAt", "published", "authorId"]
    },
    "book": {
      "title": "Book",
      "description": "A book or novel (Romanar) written by the author, including promotional and frontpage hero settings.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "coverImageUrl": { "type": "string" },
        "publishedYear": { "type": "number" },
        "isbn": { "type": "string" },
        "price": { "type": "number" },
        "buyLink": { "type": "string" },
        "buyLinkEn": { "type": "string" },
        "language": { "type": "string" },
        "isHeroFocus": { "type": "boolean", "description": "Whether this book replaces the frontpage hero" },
        "promoActive": { "type": "boolean" },
        "promoSlug": { "type": "string" },
        "promoHeadline": { "type": "string" },
        "promoBadge": { "type": "string" },
        "promoDescription": { "type": "string" },
        "promoExcerpt": { "type": "string" },
        "promoSpecialPrice": { "type": "number" },
        "promoShippingText": { "type": "string" },
        "authorNote": { "type": "string" },
        "createdAt": { "type": "number", "description": "Timestamp" },
        "updatedAt": { "type": "number", "description": "Timestamp" },
        "authorId": { "type": "string" }
      },
      "required": ["title", "description", "publishedYear", "createdAt", "updatedAt", "authorId"]
    },
    "galleryPhoto": {
      "title": "GalleryPhoto",
      "description": "An image displayed in the Foto & Natur section.",
      "type": "object",
      "properties": {
        "src": { "type": "string" },
        "alt": { "type": "string" },
        "className": { "type": "string" },
        "createdAt": { "type": "number", "description": "Timestamp" }
      },
      "required": ["src", "alt", "createdAt"]
    }
  },
  "firestore": {
    "articles": {
      "schema": { "$ref": "#/entities/article" },
      "description": "Collection of articles/reflections."
    },
    "books": {
      "schema": { "$ref": "#/entities/book" },
      "description": "Collection of books/novels."
    },
    "gallery": {
      "schema": { "$ref": "#/entities/galleryPhoto" },
      "description": "Collection of gallery photos."
    }
  }
}
