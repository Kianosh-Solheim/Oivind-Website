rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sjekkar om brukaren er innlogga
    function isSignedIn() {
      return request.auth != null;
    }

    // Berre de som eig nettsida har administratortilgang
    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null && (
               request.auth.token.email.lower() == 'kianoshsolheim@gmail.com' ||
               request.auth.token.email.lower() == 'oivindsolheim@gmail.com'
             );
    }

    // Artiklar: Alle kan lese publiserte artiklar, berre admin kan redigere/slette/sjå utkast
    match /articles/{articleId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Bøker: Alle kan sjå bøkene, berre admin kan legge til eller endre
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Biletarkiv: Alle kan sjå bilete, berre admin kan laste opp eller slette
    match /images/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Dagbok: Berre publiserte kan lesast av alle, admin styrer alt
    match /diary/{diaryId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Fotogalleri: Alle kan sjå foto, berre admin kan redigere
    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Nettside-innstillingar («Om meg» bio osv.): Alle kan lese, berre admin kan endre
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Besøks- og sidestatistikk: Må kunne oppdaterast automatisk av lesarar
    match /stats/{statId} {
      allow read, write: if true;
    }
    match /pageStats/{statId} {
      allow read, write: if true;
    }

    // Bestillingar av bøker: Kven som helst kan sende inn ei bestilling, 
    // men KUN admin har lov til å sjå kundelister, adresser og ordrestatus!
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Kommentarar: Alle kan lese, innlogga kan skrive og slette eigne, admin kan moderere alt
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // Standard for alt anna som eventuelt ikkje er nemnt: stengt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
